# Local dev. The Vite server proxies this path to FastAPI on port 8000.
VITE_API_BASE_URL=/api/v1

# Vercel production build. Set this in the Vercel project before deploying.
# Vite reads it at build time, so change it and redeploy if the API URL changes.
# No trailing slash.
# VITE_API_BASE_URL=https://earthtrend-myanmar-api.onrender.com/api/v1
