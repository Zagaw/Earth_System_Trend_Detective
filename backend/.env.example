APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NASA_POWER_COMMUNITY=SB
DEFAULT_START_YEAR=2001
DEFAULT_END_YEAR=2025
DATA_DIR=./data
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# Optional OpenRouter explanations. Leave the key blank to keep calculated explanations only.
# The key stays in this file on the server. The browser never receives it.
UNDERSTAND_AI_API_KEY=
UNDERSTAND_AI_BASE_URL=https://openrouter.ai/api/v1
UNDERSTAND_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
UNDERSTAND_AI_TIMEOUT_SECONDS=90
